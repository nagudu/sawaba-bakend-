{
  "name": "sawaba-backend",
  "version": "1.0.0",
  "description": "REST API for SAWABA Grooming Studio — appointments, services, barbers, gallery, reviews and contact management.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../scripts/sync-prisma.js && tsx watch src/server.ts",
    "build": "node ../scripts/sync-prisma.js && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "node ../scripts/prepare-prisma.js && prisma db push && node ../scripts/sync-prisma.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "prisma:generate": "node ../scripts/prepare-prisma.js && prisma generate --schema=../prisma/schema.prisma && node ../scripts/sync-prisma.js",
    "db:backfill-customers": "tsx src/scripts/legacy/backfillCustomers.ts",
    "smtp:verify": "tsx src/scripts/legacy/verifySmtp.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:pull": "prisma db pull --force",
    "db:parity": "tsx src/scripts/prismaParity.ts",
    "postinstall": "prisma generate",
    "db:field-types": "tsx src/scripts/genPrismaFieldTypes.ts"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "keywords": [
    "sawaba",
    "salon",
    "barbershop",
    "appointments",
    "rest",
    "api",
    "prisma",
    "mysql",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "prisma": "7.10.0",
    "resend": "^6.28.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
