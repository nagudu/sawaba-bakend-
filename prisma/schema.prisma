// Prisma Schema for SAWABA Grooming Studio
// Supports MySQL (local dev) and PostgreSQL (production / Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBER
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

enum BarberType {
  INTERNAL
  EXTERNAL
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum AppointmentStatus {
  PAYMENT_REQUIRED
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  READY_FOR_SERVICE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  OPAY
  BANK_TRANSFER
  CASH
  OTHER
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
  REFUNDED
  CANCELLED
}

enum CheckoutSessionStatus {
  OPEN
  AWAITING_PAYMENT
  CONVERTED
  EXPIRED
}

enum EarningStatus {
  PENDING
  EARNED
  PAID
  CANCELLED
}

enum AssignmentAction {
  ASSIGNED
  REASSIGNED
  REMOVED
}

enum BarberNotificationType {
  ASSIGNMENT
  EARNING
  APPOINTMENT
  SYSTEM
}

enum GalleryCategory {
  HAIRCUT
  FADE
  BEARD
  STYLING
  KIDS
  SALON
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ContactReplyStatus {
  PENDING
  SENT
  FAILED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

model Admin {
  id                        Int                       @id @default(autoincrement())
  name                      String                    @db.VarChar(100)
  email                     String                    @unique @db.VarChar(255)
  password                  String                    @db.VarChar(255)
  role                      Role                      @default(ADMIN)
  avatarUrl                 String?                   @map("avatar_url") @db.VarChar(500)
  isActive                  Boolean                   @default(true) @map("is_active")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  contactReplies            ContactReply[]
  commissionRateHistories   CommissionRateHistory[]
  barberAssignmentHistories BarberAssignmentHistory[]
  qrScanLogs                QrScanLog[]

  @@index([email])
  @@map("admins")
}

model Customer {
  id                 Int           @id @default(autoincrement())
  fullName           String        @map("full_name") @db.VarChar(150)
  phone              String        @db.VarChar(30)
  email              String?       @db.VarChar(255)
  customerCode       String?       @unique @map("customer_code") @db.VarChar(12)
  passwordHash       String?       @map("password_hash") @db.VarChar(255)
  preferredBarberId  Int?          @map("preferred_barber_id")
  favoriteServiceId  Int?          @map("favorite_service_id")
  avatarUrl          String?       @map("avatar_url") @db.VarChar(500)
  googleSub          String?       @unique @map("google_sub") @db.VarChar(255)
  phoneVerified      Boolean       @default(true) @map("phone_verified")
  reminderOptIn      Boolean       @default(true) @map("reminder_opt_in")
  isActive           Boolean       @default(true) @map("is_active")
  lastLoginAt        DateTime?     @map("last_login_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  appointments       Appointment[]
  payments           Payment[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerOtp {
  id         Int        @id @default(autoincrement())
  phone      String     @db.VarChar(30)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(255)
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at")
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([phone, purpose])
  @@map("customer_otps")
}

model PasswordResetOtp {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(255)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  target     String    @default("ADMIN") @db.VarChar(20)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_otps")
}

model Service {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  slug             String            @unique @db.VarChar(160)
  description      String?           @db.Text
  price            Decimal           @db.Decimal(10, 2)
  duration         Int
  image            String?           @db.VarChar(500)
  category         String            @default("HAIRCUTS") @db.VarChar(50)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  barberServices   BarberService[]
  appointments     Appointment[]
  checkoutSessions CheckoutSession[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("services")
}

model Barber {
  id                  Int                       @id @default(autoincrement())
  name                String                    @db.VarChar(150)
  slug                String                    @unique @db.VarChar(160)
  image               String?                   @db.VarChar(500)
  phone               String?                   @db.VarChar(32)
  email               String?                   @db.VarChar(255)
  specialty           String?                   @db.VarChar(255)
  biography           String?                   @db.Text
  experience          Int                       @default(0)
  rating              Decimal                   @default(0.0) @db.Decimal(2, 1)
  barberType          BarberType                @default(INTERNAL) @map("barber_type")
  location            String?                   @db.VarChar(150)
  commissionType      CommissionType            @default(PERCENTAGE) @map("commission_type")
  commissionValue     Decimal                   @default(0.0) @map("commission_value") @db.Decimal(10, 2)
  isActive            Boolean                   @default(true) @map("is_active")
  portalEnabled       Boolean                   @default(false) @map("portal_enabled")
  passwordHash        String?                   @map("password_hash") @db.VarChar(255)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  barberServices      BarberService[]
  availabilities      BarberAvailability[]
  galleries           Gallery[]
  appointments        Appointment[]             @relation("BookedBarber")
  assignedAppointments Appointment[]            @relation("AssignedBarber")
  checkoutSessions    CheckoutSession[]
  earnings            BarberEarning[]
  previousAssignments BarberAssignmentHistory[] @relation("PreviousBarber")
  newAssignments      BarberAssignmentHistory[] @relation("NewBarber")
  commissionHistory   CommissionRateHistory[]
  notifications       BarberNotification[]
  reviews             Review[]
  qrScans             QrScanLog[]

  @@index([slug])
  @@index([isActive])
  @@map("barbers")
}

model BarberService {
  id        Int      @id @default(autoincrement())
  barberId  Int      @map("barber_id")
  serviceId Int      @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@map("barber_services")
}

model BarberAvailability {
  id          Int      @id @default(autoincrement())
  barberId    Int      @map("barber_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time") @db.VarChar(8)
  endTime     String   @map("end_time") @db.VarChar(8)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("barber_availability")
}

model Appointment {
  id                 Int                       @id @default(autoincrement())
  referenceCode      String?                   @unique @map("reference_code") @db.VarChar(30)
  customerName       String                    @map("customer_name") @db.VarChar(150)
  customerPhone      String                    @map("customer_phone") @db.VarChar(30)
  customerEmail      String?                   @map("customer_email") @db.VarChar(255)
  customerLocation   String?                   @map("customer_location") @db.VarChar(150)
  customerId         Int?                      @map("customer_id")
  serviceId          Int                       @map("service_id")
  barberId           Int                       @map("barber_id")
  assignedBarberId   Int?                      @map("assigned_barber_id")
  assignedAt         DateTime?                 @map("assigned_at")
  assignedBy         Int?                      @map("assigned_by")
  appointmentDate    String                    @map("appointment_date") @db.VarChar(10)
  appointmentTime    String                    @map("appointment_time") @db.VarChar(8)
  totalAmount        Decimal                   @default(0.0) @map("total_amount") @db.Decimal(10, 2)
  notes              String?                   @db.Text
  serviceStartedAt   DateTime?                 @map("service_started_at")
  completedAt        DateTime?                 @map("completed_at")
  cancelledAt        DateTime?                 @map("cancelled_at")
  cancellationReason String?                   @map("cancellation_reason") @db.Text
  cancelledBy        Int?                      @map("cancelled_by")
  /// In-person check-in QR credentials (see QrScanLog).
  qrToken            String?                   @unique @map("qr_token") @db.VarChar(64)
  qrTokenGeneratedAt DateTime?                 @map("qr_token_generated_at")
  qrRevokedAt        DateTime?                 @map("qr_revoked_at")
  checkedInAt        DateTime?                 @map("checked_in_at")
  status             AppointmentStatus         @default(PAYMENT_REQUIRED)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  customer           Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service            Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  barber             Barber                    @relation("BookedBarber", fields: [barberId], references: [id], onDelete: Restrict)
  assignedBarber     Barber?                   @relation("AssignedBarber", fields: [assignedBarberId], references: [id], onDelete: SetNull)

  payment            Payment?
  earning            BarberEarning?
  assignmentHistory  BarberAssignmentHistory[]
  reminders          AppointmentReminder[]
  qrScans            QrScanLog[]

  @@index([appointmentDate, appointmentTime])
  @@index([barberId, appointmentDate])
  @@index([status])
  @@map("appointments")
}

/// Per-appointment QR credential used for in-person check-in. The token is a
/// high-entropy random string generated lazily and can be revoked (e.g. when the
/// appointment is cancelled) without touching the booking record itself.
model QrScanLog {
  id               Int      @id @default(autoincrement())
  appointmentId    Int?     @map("appointment_id")
  barberId         Int?     @map("barber_id")
  adminId          Int?     @map("admin_id")
  actorRole        String   @map("actor_role") @db.VarChar(16)
  outcome          String   @db.VarChar(32)
  source           String   @default("QR") @db.VarChar(16)
  tokenFingerprint String?  @map("token_fingerprint") @db.VarChar(32)
  referenceCode    String?  @map("reference_code") @db.VarChar(30)
  ip               String?  @db.VarChar(64)
  userAgent        String?  @map("user_agent") @db.VarChar(300)
  detail           String?  @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at")

  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  barber           Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  admin            Admin?       @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([barberId])
  @@index([outcome])
  @@index([createdAt])
  @@map("qr_scan_logs")
}

/// Automatic pre-appointment reminder log. One row per (appointment, kind)
/// that was successfully delivered; the unique key guarantees a customer is
/// never reminded twice for the same window even if the scheduler overlaps.
model AppointmentReminder {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @map("appointment_id")
  kind          String    @db.VarChar(10)
  channel       String    @db.VarChar(16)
  status        String    @default("SENT") @db.VarChar(16)
  error         String?   @db.VarChar(500)
  sentAt        DateTime  @default(now()) @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([kind])
  @@map("appointment_reminders")
}

model Payment {
  id                   Int           @id @default(autoincrement())
  appointmentId        Int           @unique @map("appointment_id")
  customerId           Int?          @map("customer_id")
  amount               Decimal       @default(0.0) @db.Decimal(10, 2)
  paymentMethod        PaymentMethod? @map("payment_method")
  transactionReference String?       @map("transaction_reference") @db.VarChar(191)
  paymentDate          String?       @map("payment_date") @db.VarChar(10)
  receiptUrl           String?       @map("receipt_url") @db.VarChar(500)
  receiptPublicId      String?       @map("receipt_public_id") @db.VarChar(500)
  providerRef          String?       @map("provider_ref") @db.VarChar(64)
  note                 String?       @db.Text
  status               PaymentStatus @default(UNPAID)
  rejectionReason      String?       @map("rejection_reason") @db.Text
  verifiedBy           Int?          @map("verified_by")
  verifiedAt           DateTime?     @map("verified_at")
  accessToken          String        @unique @map("access_token") @db.VarChar(64)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  appointment          Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentSetting {
  id                    Int      @id @default(autoincrement())
  shopName              String   @map("shop_name") @db.VarChar(150)
  shopAddress           String?  @map("shop_address") @db.VarChar(300)
  shopPhone             String?  @map("shop_phone") @db.VarChar(30)
  shopLogo              String?  @map("shop_logo") @db.VarChar(500)
  bankName              String?  @map("bank_name") @db.VarChar(100)
  accountName           String?  @map("account_name") @db.VarChar(150)
  accountNumber         String?  @map("account_number") @db.VarChar(30)
  opayAccountName       String?  @map("opay_account_name") @db.VarChar(150)
  opayAccountNumber     String?  @map("opay_account_number") @db.VarChar(30)
  paymentInstructions   String?  @map("payment_instructions") @db.Text
  enabledPaymentMethods Json     @map("enabled_payment_methods")
  minAmount             Decimal  @default(0.0) @map("min_amount") @db.Decimal(10, 2)
  fullPaymentRequired   Boolean  @default(true) @map("full_payment_required")
  receiptRequired       Boolean  @default(true) @map("receipt_required")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model CheckoutSession {
  id                     Int                   @id @default(autoincrement())
  sessionToken           String                @unique @map("session_token") @db.VarChar(64)
  customerName           String                @map("customer_name") @db.VarChar(150)
  customerPhone          String                @map("customer_phone") @db.VarChar(20)
  customerEmail          String?               @map("customer_email") @db.VarChar(191)
  customerLocation       String?               @map("customer_location") @db.VarChar(150)
  serviceId              Int                   @map("service_id")
  barberId               Int                   @map("barber_id")
  appointmentDate        String                @map("appointment_date") @db.VarChar(10)
  appointmentTime        String                @map("appointment_time") @db.VarChar(8)
  notes                  String?               @db.Text
  totalAmount            Decimal               @default(0.0) @map("total_amount") @db.Decimal(10, 2)
  paymentMethod          PaymentMethod?        @map("payment_method")
  transactionReference   String?               @map("transaction_reference") @db.VarChar(191)
  status                 CheckoutSessionStatus @default(OPEN)
  paystackReference      String?               @map("paystack_reference") @db.VarChar(191)
  convertedAppointmentId Int?                  @map("converted_appointment_id")
  receiptUrl             String?               @map("receipt_url") @db.VarChar(500)
  receiptPublicId        String?               @map("receipt_public_id") @db.VarChar(500)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  service                Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber                 Barber                @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([appointmentDate])
  @@index([paystackReference])
  @@map("checkout_sessions")
}

model BarberEarning {
  id                     Int            @id @default(autoincrement())
  appointmentId          Int            @unique @map("appointment_id")
  barberId               Int            @map("barber_id")
  barberTypeSnapshot     BarberType     @map("barber_type_snapshot")
  commissionType         CommissionType @map("commission_type")
  commissionRateSnapshot Decimal        @map("commission_rate_snapshot") @db.Decimal(10, 2)
  serviceAmount          Decimal        @map("service_amount") @db.Decimal(10, 2)
  commissionAmount       Decimal        @map("commission_amount") @db.Decimal(10, 2)
  studioAmount           Decimal        @map("studio_amount") @db.Decimal(10, 2)
  status                 EarningStatus  @default(PENDING)
  earnedAt               DateTime?      @map("earned_at")
  paidAt                 DateTime?      @map("paid_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  appointment            Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barber                 Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, status])
  @@index([appointmentId])
  @@index([status])
  @@map("barber_earnings")
}

model BarberAssignmentHistory {
  id               Int              @id @default(autoincrement())
  appointmentId    Int              @map("appointment_id")
  previousBarberId Int?             @map("previous_barber_id")
  newBarberId      Int?             @map("new_barber_id")
  action           AssignmentAction
  reason           String?          @db.VarChar(300)
  changedByAdminId Int?             @map("changed_by_admin_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  appointment      Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousBarber   Barber?          @relation("PreviousBarber", fields: [previousBarberId], references: [id], onDelete: SetNull)
  newBarber        Barber?          @relation("NewBarber", fields: [newBarberId], references: [id], onDelete: SetNull)
  changedBy        Admin?           @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("barber_assignment_history")
}

model CommissionRateHistory {
  id               Int            @id @default(autoincrement())
  barberId         Int            @map("barber_id")
  commissionType   CommissionType @map("commission_type")
  commissionValue  Decimal        @map("commission_value") @db.Decimal(10, 2)
  effectiveFrom    DateTime       @default(now()) @map("effective_from")
  changedByAdminId Int?           @map("changed_by_admin_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  barber           Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  changedBy        Admin?         @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([barberId])
  @@index([effectiveFrom])
  @@map("commission_rate_history")
}

model BarberNotification {
  id        Int                    @id @default(autoincrement())
  barberId  Int                    @map("barber_id")
  type      BarberNotificationType @default(SYSTEM)
  title     String                 @db.VarChar(160)
  message   String                 @db.Text
  readAt    DateTime?              @map("read_at")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  barber    Barber                 @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@index([readAt])
  @@map("barber_notifications")
}

model Gallery {
  id            Int               @id @default(autoincrement())
  title         String            @db.VarChar(200)
  image         String?           @db.VarChar(500)
  video         String?           @db.VarChar(500)
  videoPublicId String?           @map("video_public_id") @db.VarChar(300)
  mediaType     GalleryMediaType  @default(IMAGE) @map("media_type")
  duration      Int?
  category      GalleryCategory   @default(HAIRCUT)
  barberId      Int?              @map("barber_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  barber        Barber?           @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([barberId])
  @@index([mediaType])
  @@map("gallery")
}

model Review {
  id            Int          @id @default(autoincrement())
  customerName  String       @map("customer_name") @db.VarChar(150)
  customerPhone String?      @map("customer_phone") @db.VarChar(32)
  customerEmail String?      @map("customer_email") @db.VarChar(255)
  customerImage String?      @map("customer_image") @db.VarChar(500)
  serviceId     Int?         @map("service_id")
  serviceName   String?      @map("service_name") @db.VarChar(150)
  barberId      Int?         @map("barber_id")
  rating        Int          @default(5)
  comment       String       @db.Text
  status        ReviewStatus @default(PENDING)
  isApproved    Boolean      @default(false) @map("is_approved")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  barber        Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([isApproved])
  @@index([status])
  @@index([barberId])
  @@map("reviews")
}

model ContactMessage {
  id         Int                  @id @default(autoincrement())
  name       String               @db.VarChar(150)
  phone      String?              @db.VarChar(30)
  email      String               @db.VarChar(255)
  subject    String?              @db.VarChar(200)
  message    String               @db.Text
  isRead     Boolean              @default(false) @map("is_read")
  status     ContactMessageStatus @default(NEW)
  repliedAt  DateTime?            @map("replied_at")
  archivedAt DateTime?            @map("archived_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  replies    ContactReply[]

  @@index([isRead])
  @@map("contact_messages")
}

model ContactReply {
  id                Int                @id @default(autoincrement())
  contactMessageId  Int                @map("contact_message_id")
  adminId           Int?               @map("admin_id")
  adminName         String?            @map("admin_name") @db.VarChar(100)
  recipientEmail    String             @map("recipient_email") @db.VarChar(255)
  subject           String             @db.VarChar(250)
  message           String             @db.Text
  status            ContactReplyStatus @default(PENDING)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(255)
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  contactMessage    ContactMessage     @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  admin             Admin?             @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([contactMessageId])
  @@map("contact_replies")
}

model MarketplaceSetting {
  id                     Int           @id @default(1)
  defaultCommissionRate  Decimal       @default(10) @map("default_commission_rate") @db.Decimal(5, 2)
  commissionType         CommissionType @default(PERCENTAGE) @map("commission_type")
  releaseDelayDays       Int           @default(7) @map("release_delay_days")
  deliveryFee            Decimal       @default(1000) @map("delivery_fee") @db.Decimal(12, 2)
  freeDeliveryThreshold  Decimal       @default(50000) @map("free_delivery_threshold") @db.Decimal(12, 2)
  deliveryLocations      String        @default("") @map("delivery_locations") @db.VarChar(500)
  requireProductApproval Boolean       @default(true) @map("require_product_approval")
  allowGuestCheckout     Boolean       @default(true) @map("allow_guest_checkout")
  vendorRegistrationOpen Boolean       @default(true) @map("vendor_registration_open")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@map("marketplace_settings")
}

model Vendor {
  id                 Int           @id @default(autoincrement())
  businessName       String        @map("business_name") @db.VarChar(150)
  contactName        String        @map("contact_name") @db.VarChar(150)
  slug               String        @unique @db.VarChar(160)
  email              String        @unique @db.VarChar(255)
  phone              String        @db.VarChar(32)
  passwordHash       String        @map("password_hash") @db.VarChar(255)
  logoUrl            String?       @map("logo_url") @db.VarChar(500)
  address            String?       @db.VarChar(300)
  location           String?       @db.VarChar(150)
  bankName           String?       @map("bank_name") @db.VarChar(150)
  bankAccountName    String?       @map("bank_account_name") @db.VarChar(150)
  bankAccountNumber  String?       @map("bank_account_number") @db.VarChar(50)
  businessInfo       String?       @map("business_info") @db.Text
  status             String        @default("PENDING") @db.VarChar(20)
  statusReason       String?       @map("status_reason") @db.VarChar(500)
  commissionRate     Decimal?      @map("commission_rate") @db.Decimal(5, 2)
  rating             Decimal       @default(0) @db.Decimal(2, 1)
  isActive           Boolean       @default(true) @map("is_active")
  isOfficial         Boolean       @default(false) @map("is_official")
  approvedAt         DateTime?     @map("approved_at")
  approvedByAdminId  Int?          @map("approved_by_admin_id")
  suspendedAt        DateTime?     @map("suspended_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  products           Product[]
  orderItems         ShopOrderItem[]
  commissionLedger   CommissionLedger[]
  payouts            VendorPayout[]
  productReviews     ProductReview[]

  @@index([status])
  @@map("vendors")
}

model ProductCategory {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(140)
  description    String?   @db.Text
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  commissionRate Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  products       Product[]

  @@map("product_categories")
}

model Product {
  id                Int                 @id @default(autoincrement())
  vendorId          Int                 @map("vendor_id")
  categoryId        Int?                @map("category_id")
  name              String              @db.VarChar(200)
  slug              String              @unique @db.VarChar(220)
  sku               String?             @unique @db.VarChar(100)
  description       String              @db.Text
  brand             String?             @db.VarChar(150)
  price             Decimal             @db.Decimal(12, 2)
  compareAtPrice    Decimal?            @map("compare_at_price") @db.Decimal(12, 2)
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(5) @map("low_stock_threshold")
  status            ProductStatus      @default(DRAFT)
  isActive          Boolean             @default(true) @map("is_active")
  rating            Float               @default(0)
  reviewCount       Int                 @default(0) @map("review_count")
  salesCount        Int                 @default(0) @map("sales_count")
  rejectionReason   String?             @map("rejection_reason") @db.VarChar(500)
  approvedAt        DateTime?           @map("approved_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  category          ProductCategory?    @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variations        ProductVariation[]
  orderItems        ShopOrderItem[]
  cartItems         ShopCartItem[]
  reviews           ProductReview[]
  commissionLedger  CommissionLedger[]

  @@index([createdAt])
  @@index([categoryId])
  @@index([isActive])
  @@index([price])
  @@index([status])
  @@index([vendorId])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariation {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String   @db.VarChar(80)
  value     String   @db.VarChar(80)
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems ShopCartItem[]

  @@index([productId])
  @@map("product_variations")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  vendorId  Int?     @map("vendor_id")
  change    Int
  reason    String   @db.VarChar(40)
  reference String?  @db.VarChar(40)
  note      String?  @db.VarChar(300)
  actorRole String?  @map("actor_role") @db.VarChar(30)
  actorId   Int?     @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([vendorId])
  @@map("stock_movements")
}

model ShopCart {
  id         Int           @id @default(autoincrement())
  token      String        @unique @db.VarChar(64)
  customerId Int?          @map("customer_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  items      ShopCartItem[]

  @@index([customerId])
  @@map("shop_carts")
}

model ShopCartItem {
  id          Int              @id @default(autoincrement())
  cartId      Int              @map("cart_id")
  productId   Int              @map("product_id")
  variationId Int?             @map("variation_id")
  quantity    Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  cart        ShopCart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation   ProductVariation? @relation(fields: [variationId], references: [id])

  @@index([cartId])
  @@index([productId], map: "shop_cart_items_product_id_fkey")
  @@index([variationId], map: "shop_cart_items_variation_id_fkey")
  @@map("shop_cart_items")
}

model ShopOrder {
  id                 Int                 @id @default(autoincrement())
  referenceCode      String              @unique @map("reference_code") @db.VarChar(40)
  customerId         Int?                @map("customer_id")
  customerName       String              @map("customer_name") @db.VarChar(150)
  customerPhone      String              @map("customer_phone") @db.VarChar(32)
  customerEmail      String?             @map("customer_email") @db.VarChar(255)
  deliveryAddress    String              @map("delivery_address") @db.VarChar(500)
  deliveryLocation   String?             @map("delivery_location") @db.VarChar(200)
  notes              String?             @db.Text
  subtotal           Decimal             @db.Decimal(12, 2)
  deliveryFee        Decimal             @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  discount           Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(12, 2)
  status             String              @default("AWAITING_PAYMENT") @db.VarChar(30)
  paymentMethod      String              @map("payment_method") @db.VarChar(30)
  paymentStatus      String              @default("UNPAID") @map("payment_status") @db.VarChar(30)
  transactionRef     String?             @map("transaction_ref")
  receiptUrl         String?             @map("receipt_url") @db.VarChar(500)
  receiptPublicId    String?             @map("receipt_public_id") @db.VarChar(300)
  paymentNote        String?             @map("payment_note") @db.VarChar(500)
  paymentVerifiedAt  DateTime?           @map("payment_verified_at")
  paymentVerifiedBy  Int?                @map("payment_verified_by")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancelReason       String?             @map("cancel_reason") @db.VarChar(500)
  deliveredAt        DateTime?           @map("delivered_at")
  refundedAmount     Decimal             @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt         DateTime?           @map("refunded_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  items              ShopOrderItem[]
  payment            ShopPayment?
  events             ShopPaymentEvent[]
  refunds            ShopRefund[]
  ledger             CommissionLedger[]

  @@index([createdAt])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([status])
  @@map("shop_orders")
}

model ShopOrderItem {
  id               Int                 @id @default(autoincrement())
  orderId           Int                 @map("order_id")
  vendorId          Int                 @map("vendor_id")
  productId         Int                 @map("product_id")
  variationId       Int?                @map("variation_id")
  productName       String              @map("product_name") @db.VarChar(200)
  productImage      String?             @map("product_image") @db.VarChar(500)
  variationLabel    String?             @map("variation_label") @db.VarChar(150)
  unitPrice         Decimal             @map("unit_price") @db.Decimal(12, 2)
  quantity          Int
  lineTotal         Decimal             @map("line_total") @db.Decimal(12, 2)
  commissionRate    Decimal             @map("commission_rate") @db.Decimal(12, 2)
  commissionAmount  Decimal             @map("commission_amount") @db.Decimal(12, 2)
  vendorNet         Decimal             @map("vendor_net") @db.Decimal(12, 2)
  status            String              @default("PENDING") @db.VarChar(20)
  trackingInfo      String?             @map("tracking_info") @db.VarChar(300)
  confirmedAt       DateTime?           @map("confirmed_at")
  shippedAt         DateTime?           @map("shipped_at")
  deliveredAt       DateTime?           @map("delivered_at")
  cancelReason      String?             @map("cancel_reason") @db.VarChar(300)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  order             ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  product           Product             @relation(fields: [productId], references: [id])
  ledger            CommissionLedger?

  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([vendorId])
  @@map("shop_order_items")
}

model ShopPayment {
  id                 Int               @id @default(autoincrement())
  orderId            Int               @unique @map("order_id")
  amount             Decimal           @db.Decimal(12, 2)
  paymentMethod      String            @map("payment_method") @db.VarChar(30)
  status             String            @default("UNPAID") @db.VarChar(30)
  transactionRef     String?           @map("transaction_ref")
  providerRef        String?           @map("provider_ref")
  rejectionReason    String?           @map("rejection_reason") @db.VarChar(500)
  verifiedAt         DateTime?         @map("verified_at")
  verifiedByAdminId  Int?              @map("verified_by_admin_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  order              ShopOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shop_payments")
}

model ShopPaymentEvent {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  type           String   @db.VarChar(50)
  status         String   @db.VarChar(30)
  provider       String?  @db.VarChar(30)
  providerRef    String?  @map("provider_ref")
  amount         Decimal? @db.Decimal(12, 2)
  actorRole      String?  @map("actor_role") @db.VarChar(30)
  actorId        Int?     @map("actor_id")
  detail         String?  @db.Text
  payload        String?  @db.LongText
  createdAt      DateTime @default(now()) @map("created_at")

  order          ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shop_payment_events")
}

model ShopRefund {
  id          Int             @id @default(autoincrement())
  orderId     Int             @map("order_id")
  vendorId    Int?            @map("vendor_id")
  reason      String          @db.Text
  amount      Decimal         @db.Decimal(12, 2)
  status      String          @default("PENDING") @db.VarChar(20)
  requestedBy String          @map("requested_by") @db.VarChar(150)
  resolution  String?         @db.Text
  resolvedBy  Int?            @map("resolved_by")
  resolvedAt  DateTime?       @map("resolved_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  order       ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("shop_refunds")
}

model CommissionLedger {
  id                Int                        @id @default(autoincrement())
  orderId           Int                        @map("order_id")
  orderItemId       Int                        @unique @map("order_item_id")
  vendorId          Int                        @map("vendor_id")
  productId         Int                        @map("product_id")
  quantity          Int
  salePrice         Decimal                    @map("sale_price") @db.Decimal(12, 2)
  commissionRate    Decimal                    @map("commission_rate") @db.Decimal(12, 2)
  commissionAmount  Decimal                    @map("commission_amount") @db.Decimal(12, 2)
  vendorNet         Decimal                    @map("vendor_net") @db.Decimal(12, 2)
  reversedAmount    Decimal                    @default(0) @map("reversed_amount") @db.Decimal(12, 2)
  settlementStatus  String                     @default("PENDING") @map("settlement_status") @db.VarChar(20)
  payoutId          Int?                       @map("payout_id")
  releasedAt        DateTime?                  @map("released_at")
  paidAt            DateTime?                  @map("paid_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  order             ShopOrder                  @relation(fields: [orderId], references: [id])
  orderItem         ShopOrderItem              @relation(fields: [orderItemId], references: [id])
  vendor            Vendor                     @relation(fields: [vendorId], references: [id])
  product           Product                    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([payoutId])
  @@index([productId], map: "commission_ledger_product_id_fkey")
  @@index([settlementStatus])
  @@index([vendorId])
  @@map("commission_ledger")
}

model VendorPayout {
  id                 Int               @id @default(autoincrement())
  referenceCode      String            @unique @map("reference_code") @db.VarChar(40)
  vendorId           Int               @map("vendor_id")
  amount             Decimal           @db.Decimal(12, 2)
  status             String            @default("REQUESTED") @db.VarChar(20)
  note               String?           @db.VarChar(500)
  transactionRef     String?            @map("transaction_ref")
  processedByAdminId Int?               @map("processed_by_admin_id")
  requestedAt        DateTime           @default(now()) @map("requested_at")
  processedAt        DateTime?          @map("processed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vendor             Vendor              @relation(fields: [vendorId], references: [id])

  @@index([status])
  @@index([vendorId])
  @@map("vendor_payouts")
}

model VendorNotification {
  id        Int      @id @default(autoincrement())
  vendorId  Int      @map("vendor_id")
  type      String   @db.VarChar(40)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([readAt])
  @@index([vendorId])
  @@map("vendor_notifications")
}

model ProductReview {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  vendorId     Int          @map("vendor_id")
  orderId      Int          @map("order_id")
  customerId   Int?         @map("customer_id")
  customerName String       @map("customer_name") @db.VarChar(150)
  rating       Float        @default(5)
  comment      String       @db.Text
  status       String       @default("PENDING") @db.VarChar(20)
  isApproved   Boolean      @default(false) @map("is_approved")
  reply        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  product      Product      @relation(fields: [productId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([vendorId])
  @@map("product_reviews")
}

model MarketplaceAuditLog {
  id         Int      @id @default(autoincrement())
  actorRole  String   @map("actor_role") @db.VarChar(30)
  actorId    Int?     @map("actor_id")
  actorName  String?  @map("actor_name") @db.VarChar(150)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   Int?     @map("entity_id")
  detail     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("marketplace_audit_logs")
}
