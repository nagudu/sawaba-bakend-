# ─── Server ────────────────────────────────
PORT=5000
NODE_ENV=development

# Single-service deploys only: absolute path to the built frontend. When set, Express
# serves that folder plus an index.html fallback so deep links (/admin/*, /pay/:token,
# /account/*) survive a refresh. Leave unset for local dev — Vite serves the SPA.
# Railway: SERVE_STATIC_DIR=/app/spa
# SERVE_STATIC_DIR=../deploy/spa

# ─── Database (MySQL) ──────────────────────
# Local dev:  mysql://root@localhost:3306/sawaba_groom
# Hosted:     mysql://USER:PASSWORD@HOST:PORT/dbname?ssl-mode=REQUIRED   (+ DB_SSL=true)
DATABASE_URL=mysql://root@localhost:3306/sawaba_groom
# Set to true ONLY when the database host terminates TLS (Aiven/Railway/PlanetScale etc.)
DB_SSL=false

# ─── JWT ───────────────────────────────────
JWT_SECRET=change-me-64-random-chars
JWT_EXPIRES_IN=1d

# ─── Client ────────────────────────────────
# Where the frontend is served from — used for CORS (see EXTRA_CLIENT_ORIGINS)
CLIENT_URL=http://localhost:5173
# Comma-separated additional allowed origins (deployed frontend, previews)
EXTRA_CLIENT_ORIGINS=https://sawabagroomingstudio.com.ng,https://www.sawabagroomingstudio.com.ng

# ─── Cloudinary (Required on Vercel / serverless) ──────
# On Vercel, UPLOAD_DRIVER automatically defaults to "cloudinary".
# For local development, set UPLOAD_DRIVER=cloudinary to test cloud uploads,
# or leave unset / set to "local" for offline local file storage in backend/uploads.
UPLOAD_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=sawaba-salon
# Alternatively, supply the single connection URL provided by Cloudinary:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── Seed admin (created by `npm run db:sync`) ──
ADMIN_SEED_EMAIL=admin@sawabasalon.com
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=SAWABA Admin

# ─── Resend (transactional email: OTP login codes, contact replies) ──
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ─── Paystack (online payments, TEST MODE) ──
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ─── Barber Portal credentials email ──
# Public URL of the barber portal — included in credential emails.
PORTAL_URL=http://localhost:5173/barber

# ─── Google Sign-In (optional) ────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Add your frontend URL to "Authorized JavaScript origins".
# Leave blank to disable Google sign-in entirely; phone OTP + password login
# continue to work. Must match VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=

# ─── Automatic appointment reminders ────────
# Sends customers an automatic reminder before their appointment (default 24h
# and 1h before). Delivery prefers email (RESEND/SMTP above) and falls back to
# SMS (Termii config above) when email is unavailable.
#
# CRON_SECRET authorises the scheduler endpoint. On Vercel, set this here and
# the platform's Cron automatically sends it as `Authorization: Bearer ...`.
# Leave blank locally to allow the endpoint in development only.
CRON_SECRET=
# Comma-separated reminder windows, in hours before the appointment.
REMINDER_HOURS_BEFORE=24,1
# Studio wall clock offset from UTC in minutes (Nigeria / WAT = 60).
REMINDER_TZ_OFFSET_MINUTES=60
# How often the long-lived-host scheduler checks for due reminders (minutes).
REMINDER_INTERVAL_MINUTES=15
# Set to false to disable the in-process scheduler (e.g. when relying on cron).
REMINDER_SCHEDULER_ENABLED=true

# ─── Customer notifications (SMS / WhatsApp / Email) ──
# These values are DEFAULTS/fallbacks. The Admin dashboard → Notifications page
# can also set them, and anything saved there takes precedence over these.
#
# At-rest encryption key for credentials saved from the dashboard. Use a 64-char
# hex (32-byte) value or any passphrase. REQUIRED in production to encrypt secrets.
ENCRYPTION_KEY=

# Termii SMS (or compatible) — fallback for the dashboard's SMS settings.
SMS_API_KEY=
SMS_SENDER_ID=
# SMS_BASE_URL=https://api.ng.termii.com

# WhatsApp Business (Meta Cloud API) — fallback for the dashboard's WhatsApp settings.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v19.0

# SMTP fallback for email (used when Resend is unavailable / not configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SAWABA Grooming Studio

# Optional default recipient for admin "Send test" when no customer is chosen.
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=

# ─── Guest order tracking links ──
# Lifetime (in days) of the signed, per-order tracking link. After it expires the
# customer can request a fresh link from the Track Order lookup form.
ORDER_TRACKING_LINK_DAYS=30
